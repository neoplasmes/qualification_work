{
    "mcpServers": {
        "codebase-memory-mcp": {
            "type": "stdio",
            "command": "proto",
            "args": [
                "run",
                "codebase-memory-mcp",
                "--log",
                "error",
                "--reporter",
                "text",
                "--"
            ],
            "env": {}
        },
        "kubernetes": {
            "type": "stdio",
            "command": "proto",
            "args": [
                "run",
                "kubernetes-mcp-server",
                "--log",
                "error",
                "--reporter",
                "text",
                "--"
            ],
            "env": {
                "KUBECONFIG": "/home/neoplasmes/.kube/config"
            }
        },
        "moon": {
            "type": "stdio",
            "command": "proto",
            "args": ["run", "moon", "--log", "error", "--reporter", "text", "--", "mcp"],
            "env": {
                "MOON_WORKSPACE_ROOT": "/home/neoplasmes/qualification_work"
            }
        }
    }
}
