# local dev against a k3d cluster (env:cluster-up, env:apply)
KUBECONFIG=/home/user/.kube/config
NAMESPACE=app
WATCH_SERVICES=client_backend:3000:client:least_conn,server_backend:3001:server:least_conn
NGINX_PID_FILE=/tmp/openresty-discovery/nginx.pid
UPSTREAMS_OUTPUT=/tmp/openresty-discovery/upstreams.conf
