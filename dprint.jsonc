{
    "includes": [
        "**/*.{js,ts,tsx,json,jsonc,css,scss,html,go,yaml,yml,md,toml}",
        "**/.prototools"
    ],
    "excludes": [
        "**/node_modules",
        "**/dist",
        "**/bin",
        ".git",
        ".moon/cache",
        ".agents",
        ".claude",
        "docs",
        "generation",
        "diplom-notes",
        "packages/design-system/refs",
        // exact token snapshot and its projection, verified by tokenContract.test.ts
        "packages/design-system/src/theme/tokens.{json,css}",
        // contracts edited by hand only
        "ARCHITECTURE.frontend.md",
        "apps/auth/ARCHITECTURE.md",
        "**/test-results",
        "**/playwright-report"
    ],
    "exec": {
        "cwd": "${configDir}",
        "commands": [
            {
                "command": "node_modules/.bin/biome format --stdin-file-path={{file_path}}",
                "exts": ["js", "ts", "tsx", "json", "jsonc", "css", "scss", "html"],
                "cacheKeyFiles": ["biome.json", "pnpm-lock.yaml", ".prototools"]
            },
            {
                "command": "proto run go --exe gofmt",
                "exts": ["go"],
                "cacheKeyFiles": [".prototools"]
            }
        ]
    },
    "markdown": {
        "lineWidth": 90,
        "textWrap": "maintain"
    },
    "yaml": {
        "indentWidth": 2
    },
    "plugins": [
        "./node_modules/@dprint/markdown/plugin.wasm",
        "./node_modules/@dprint/toml/plugin.wasm",
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
        "https://github.com/dprint/dprint-plugin-exec/releases/download/0.7.3/plugin.json@a7898d5f1897e77bff474cec3d948c3ec3a7f455e32de2cc60c8adb9a5dd24aa"
    ]
}
