amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

local nu = "nu --no-config-file -c"

hooks {
    ["pre-commit"] {
        fix = true
        stage = true
        stash = "git"
        steps {
            ["check"] {
                shell = nu
                exclusive = true
                fix = "moon run :check --affected --status staged"
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["cocogitto"] {
                check = new Command {
                    argv = List("cog", "--quiet", "verify", "--file", "{{commit_msg_file}}")
                }
            }
        }
    }
    ["pre-push"] {
        steps {
            ["typecheck"] {
                shell = nu
                check = "moon run :typecheck"
            }
        }
    }
}
